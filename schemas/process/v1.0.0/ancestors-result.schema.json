{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.3leaps.dev/sysprims/process/v1.0.0/ancestors-result.schema.json",
  "title": "sysprims ancestors result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "timestamp",
    "platform",
    "pid",
    "chain",
    "warnings"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "https://schemas.3leaps.dev/sysprims/process/v1.0.0/ancestors-result.schema.json"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "platform": {
      "type": "string"
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "chain": {
      "type": "array",
      "items": {
        "$ref": "process-info.schema.json#/definitions/process_info"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
