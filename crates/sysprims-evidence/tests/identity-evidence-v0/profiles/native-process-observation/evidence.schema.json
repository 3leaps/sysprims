{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.3leaps.dev/identity-evidence/v0/profiles/native-process-observation/evidence.schema.json",
  "title": "Native process observation evidence (draft)",
  "description": "Shape validation only. Portable OS process incarnation and execution-context observation payload; never serializes live OS handles or authenticates caller host scope.",
  "type": "object",
  "properties": {
    "profile": {
      "$ref": "#/$defs/profile-ref"
    },
    "observed_at": {
      "$ref": "#/$defs/utc-instant"
    },
    "observer": {
      "$ref": "#/$defs/observer"
    },
    "process": {
      "$ref": "#/$defs/process"
    }
  },
  "required": [
    "profile",
    "observed_at",
    "observer",
    "process"
  ],
  "additionalProperties": false,
  "$defs": {
    "local-id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "sha256-digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utc-instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "pid-string": {
      "type": "string",
      "description": "Canonical positive 31-bit signed integer decimal string in 1..=2147483647.",
      "pattern": "^(?:[1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])$"
    },
    "profile-ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision": {
          "$ref": "#/$defs/sha256-digest"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "principal": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "namespace",
        "value"
      ],
      "additionalProperties": false
    },
    "fact-status": {
      "type": "string",
      "description": "7-state fact probe outcome with 1:1 bijection to report capabilities[].status (observed <-> available).",
      "enum": [
        "observed",
        "not-present",
        "inaccessible",
        "unsupported",
        "not-probed",
        "error",
        "unknown"
      ]
    },
    "observer": {
      "type": "object",
      "properties": {
        "platform_family": {
          "type": "string",
          "enum": [
            "linux",
            "macos",
            "windows"
          ]
        },
        "architecture": {
          "type": "string",
          "pattern": "^[a-z0-9_]{2,32}$"
        },
        "bracketed": {
          "type": "boolean"
        },
        "time_namespace": {
          "$ref": "#/$defs/namespace-fact"
        },
        "user_namespace": {
          "$ref": "#/$defs/namespace-fact"
        }
      },
      "required": [
        "platform_family",
        "architecture",
        "bracketed",
        "time_namespace",
        "user_namespace"
      ],
      "additionalProperties": false
    },
    "host-scope": {
      "type": "object",
      "properties": {
        "identifier_ref": {
          "$ref": "#/$defs/local-id"
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "derivation": {
          "$ref": "#/$defs/profile-ref"
        },
        "stability": {
          "type": "string",
          "enum": [
            "unknown",
            "process",
            "boot",
            "installation",
            "enrollment",
            "device"
          ]
        },
        "clone_behavior": {
          "type": "string",
          "enum": [
            "unknown",
            "copyable",
            "regenerated",
            "device-bound"
          ]
        }
      },
      "required": [
        "namespace",
        "value",
        "derivation",
        "stability",
        "clone_behavior"
      ],
      "additionalProperties": false
    },
    "boot-id-fact": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/fact-status"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "status": {
            "const": "observed"
          }
        }
      },
      "then": {
        "required": [
          "value"
        ]
      },
      "else": {
        "required": [
          "reason"
        ],
        "not": {
          "required": [
            "value"
          ]
        }
      }
    },
    "namespace-fact": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/fact-status"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,31}:[!-~]{1,256}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "status": {
            "const": "observed"
          }
        }
      },
      "then": {
        "required": [
          "value"
        ]
      },
      "else": {
        "required": [
          "reason"
        ],
        "not": {
          "required": [
            "value"
          ]
        }
      }
    },
    "state-fact": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/fact-status"
        },
        "value": {
          "type": "string",
          "enum": [
            "live",
            "zombie"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "status": {
            "const": "observed"
          }
        }
      },
      "then": {
        "required": [
          "value"
        ]
      },
      "else": {
        "required": [
          "reason"
        ],
        "not": {
          "required": [
            "value"
          ]
        }
      }
    },
    "start-identity-fact": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/fact-status"
        },
        "profile": {
          "$ref": "#/$defs/profile-ref"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "status",
        "profile"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "status": {
            "const": "observed"
          }
        }
      },
      "then": {
        "required": [
          "value"
        ]
      },
      "else": {
        "required": [
          "reason"
        ],
        "not": {
          "required": [
            "value"
          ]
        }
      }
    },
    "principal-fact": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/fact-status"
        },
        "derivation": {
          "$ref": "#/$defs/profile-ref"
        },
        "principal": {
          "$ref": "#/$defs/principal"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "status": {
            "const": "observed"
          }
        }
      },
      "then": {
        "required": [
          "derivation",
          "principal"
        ]
      },
      "else": {
        "required": [
          "reason"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "derivation"
              ]
            },
            {
              "required": [
                "principal"
              ]
            }
          ]
        }
      }
    },
    "digest-fact": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/fact-status"
        },
        "derivation": {
          "$ref": "#/$defs/profile-ref"
        },
        "digest": {
          "$ref": "#/$defs/sha256-digest"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "status": {
            "const": "observed"
          }
        }
      },
      "then": {
        "required": [
          "derivation",
          "digest"
        ]
      },
      "else": {
        "required": [
          "reason"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "derivation"
              ]
            },
            {
              "required": [
                "digest"
              ]
            }
          ]
        }
      }
    },
    "execution-context": {
      "type": "object",
      "properties": {
        "security_principal": {
          "$ref": "#/$defs/principal-fact"
        },
        "namespace_context_digest": {
          "$ref": "#/$defs/digest-fact"
        },
        "executable_digest": {
          "$ref": "#/$defs/digest-fact"
        },
        "arguments_digest": {
          "$ref": "#/$defs/digest-fact"
        },
        "security_context_digest": {
          "$ref": "#/$defs/digest-fact"
        }
      },
      "required": [
        "security_principal",
        "namespace_context_digest",
        "executable_digest",
        "arguments_digest",
        "security_context_digest"
      ],
      "additionalProperties": false
    },
    "process": {
      "type": "object",
      "properties": {
        "subject_ref": {
          "$ref": "#/$defs/local-id"
        },
        "host_scope": {
          "$ref": "#/$defs/host-scope"
        },
        "boot_id": {
          "$ref": "#/$defs/boot-id-fact"
        },
        "pid_numbering_namespace": {
          "$ref": "#/$defs/namespace-fact"
        },
        "target_pid_namespace": {
          "$ref": "#/$defs/namespace-fact"
        },
        "pid": {
          "$ref": "#/$defs/pid-string"
        },
        "process_state": {
          "$ref": "#/$defs/state-fact"
        },
        "start_identity": {
          "$ref": "#/$defs/start-identity-fact"
        },
        "execution_context": {
          "$ref": "#/$defs/execution-context"
        }
      },
      "required": [
        "subject_ref",
        "host_scope",
        "boot_id",
        "pid_numbering_namespace",
        "target_pid_namespace",
        "pid",
        "process_state",
        "start_identity",
        "execution_context"
      ],
      "additionalProperties": false
    }
  }
}
