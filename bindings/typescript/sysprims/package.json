{
  "name": "@3leaps/sysprims",
  "version": "0.2.4",
  "description": "GPL-free cross-platform process utilities (TypeScript bindings via Node-API native addon)",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3leaps/sysprims.git",
    "directory": "bindings/typescript/sysprims"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "native/",
    "docs/capability-intent-matrix.md",
    "docs/public-api.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "napi": {
    "binaryName": "sysprims",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "build:native": "napi build --manifest-path native/Cargo.toml --release --platform --strip --output-dir dist/native",
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.test.json",
    "api:generate": "node scripts/public-api.js generate",
    "api:check": "node --test scripts/public-api.test.js && node scripts/public-api.js check",
    "api:check:native": "node scripts/public-api.js check --require-native",
    "platform-packages:check": "node scripts/verify-platform-packages.js",
    "test": "npm run clean && npm run build && npm run build:native && npm run build:test && node scripts/run-tests.js",
    "test:ci": "npm run clean && npm run build && npm run build:native && npm run build:test && node scripts/run-tests.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "platform-packages:set": "node scripts/set-platform-packages.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@napi-rs/cli": "3.10.8",
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@6.0.3"
  }
}
